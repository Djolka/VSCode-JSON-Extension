{
  "name": "schema-path-generator",
  "displayName": "Schema Path Generator",
  "description": "Extension for generating attribute full path from schema",
  "publisher": "Djolka",
  "icon": "icon/icon.png",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:schema-path-generator.SchemaPathGenerator",
    "onCommand:form-path-generator.FormPathGenerator"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "schema-path-generator.SchemaPathGenerator",
        "title": "Generate Schema Path"
      },
      {
        "command": "form-path-generator.FormPathGenerator",
        "title": "Generate Form Path"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == json && editorHasSelection",
          "command": "schema-path-generator.SchemaPathGenerator",
          "group": "navigation"
        },
        {
          "when": "editorLangId == json && editorHasSelection",
          "command": "form-path-generator.FormPathGenerator",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}